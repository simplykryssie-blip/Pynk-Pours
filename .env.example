# PynkPours environment variables — NAMES ONLY. Never commit real values.
# Copy to .env.local for local development. Set real values in Vercel project
# settings (separate Preview and Production values).

# --- Public (safe to expose to the browser) ---------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---------------------------
# Optional dedicated staff hostname, e.g. admin.pynkpours.com (no https://).
# When set, /admin lives only on this host and its root opens the dashboard.
# Set it only after the domain is attached in Vercel and its DNS has verified.
ADMIN_HOST=
# Supabase secret key (replaces the legacy service_role key)
SUPABASE_SECRET_KEY=
# Stripe — test mode (sk_test_...) until the owner approves go-live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must stay "false" until launch approval; live keys are refused otherwise
STRIPE_ALLOW_LIVE=false
# Turn on online checkout (requires STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET)
CHECKOUT_ENABLED=false
# LOCAL AUTOMATED TESTS ONLY: point the SDK at tests/support/stripe-double.mts.
# Must be unset when using real Stripe (test or live).
STRIPE_API_BASE=
PYNKPOURS_LOCAL_TEST=
# Transactional email (Resend recommended)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_INBOX_EMAIL=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TICKET_CREDENTIAL_KEY=
# 32+ random characters each
RATE_LIMIT_SALT=
CRON_SECRET=
# Optional bot protection
TURNSTILE_SECRET_KEY=
